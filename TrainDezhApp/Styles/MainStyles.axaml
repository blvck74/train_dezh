<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Основные цвета -->
    <Styles.Resources>
        <SolidColorBrush x:Key="PrimaryBrush">#2563EB</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryBrush">#64748B</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#10B981</SolidColorBrush>
        <SolidColorBrush x:Key="DangerBrush">#EF4444</SolidColorBrush>
        <SolidColorBrush x:Key="WarningBrush">#F59E0B</SolidColorBrush>
        <SolidColorBrush x:Key="SidebarBrush">#F8FAFC</SolidColorBrush>
        <SolidColorBrush x:Key="ContentBrush">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush">#E2E8F0</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush">#1E293B</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondaryBrush">#64748B</SolidColorBrush>
    </Styles.Resources>

    <!-- Стиль для боковой панели -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- Стиль для кнопок навигации -->
    <Style Selector="Button.nav-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.nav-button:pointerover">
        <Setter Property="Background" Value="#E2E8F0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.nav-button.active">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.nav-button.active:pointerover">
        <Setter Property="Background" Value="#1D4ED8"/>
    </Style>

    <!-- Стиль для контентной области -->
    <Style Selector="Border.content-area">
        <Setter Property="Background" Value="{StaticResource ContentBrush}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <!-- Стиль для заголовков страниц -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>

    <!-- Стиль для подзаголовков -->
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Стиль для карточек -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 rgba(0,0,0,0.1), 0 1 2 0 rgba(0,0,0,0.06)"/>
    </Style>

    <!-- Стиль для статистических карточек -->
    <Style Selector="Border.stat-card">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,16,16"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 rgba(0,0,0,0.1), 0 1 2 0 rgba(0,0,0,0.06)"/>
        <Setter Property="MinHeight" Value="120"/>
    </Style>

    <!-- Стиль для иконок -->
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для больших чисел в статистике -->
    <Style Selector="TextBlock.stat-number">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Стиль для меток статистики -->
    <Style Selector="TextBlock.stat-label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Стили для ролей пользователей -->
    <Style Selector="Border.role-badge">
        <Setter Property="Background" Value="#E0E7FF"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.role-badge.admin">
        <Setter Property="Background" Value="#FEF3C7"/>
    </Style>

    <Style Selector="Border.role-badge TextBlock">
        <Setter Property="Foreground" Value="#3730A3"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.role-badge.admin TextBlock">
        <Setter Property="Foreground" Value="#92400E"/>
    </Style>

    <!-- Стили для кнопок-иконок -->
    <Style Selector="Button.icon-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.icon-button:pointerover">
        <Setter Property="Background" Value="#E2E8F0"/>
    </Style>

</Styles>