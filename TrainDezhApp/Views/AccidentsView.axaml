<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDezhApp.ViewModels"
             xmlns:converters="using:TrainDezhApp.Converters"
             x:Class="TrainDezhApp.Views.AccidentsView"
             x:DataType="vm:AccidentsViewModel">

    <ScrollViewer>
        <StackPanel>
            
            <!-- Заголовок страницы -->
            <TextBlock Text="⚠️ Аварии" Classes="page-title"/>
            <TextBlock Text="Мониторинг и управление аварийными ситуациями" Classes="page-subtitle"/>

            <!-- Панель действий -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="🚨 Новая авария" 
                        Background="#EF4444" 
                        Foreground="White" 
                        Padding="12,8" 
                        Margin="0,0,12,0"
                        CornerRadius="6"/>
                <Button Content="📋 Протокол" 
                        Background="#64748B" 
                        Foreground="White" 
                        Padding="12,8" 
                        Margin="0,0,12,0"
                        CornerRadius="6"/>
            </StackPanel>

            <!-- Список аварий -->
            <Border Classes="card">
                <StackPanel>
                    
                    <!-- Заголовок таблицы -->
                    <Border Background="#F8FAFC" 
                            Margin="-20,-20,-20,0" 
                            Padding="20,16">
                        <Grid ColumnDefinitions="*,120,80,120">
                        <TextBlock Grid.Column="0" 
                                   Text="Описание" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Grid.Column="1" 
                                   Text="Критичность" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Grid.Column="2" 
                                   Text="Время" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Grid.Column="3" 
                                   Text="Статус" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Строки данных -->
                    <ItemsControl ItemsSource="{Binding Accidents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" 
                                        BorderThickness="0,1,0,0" 
                                        Padding="0,16">
                                    <Grid ColumnDefinitions="*,120,80,120">
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Description}" 
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        
                                        <Border Grid.Column="1" 
                                                Background="{Binding Severity, Converter={x:Static converters:SeverityToColorConverter.Instance}}"
                                                CornerRadius="12" 
                                                Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Severity}" 
                                                       FontSize="12" 
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Time}" 
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        
                                        <Border Grid.Column="3" 
                                                Background="{Binding Status, Converter={x:Static converters:AccidentStatusToColorConverter.Instance}}"
                                                CornerRadius="12" 
                                                Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" 
                                                       FontSize="12" 
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>