<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDezhApp.ViewModels"
             xmlns:converters="using:TrainDezhApp.Converters"
             x:Class="TrainDezhApp.Views.ShiftHandoverView"
             x:DataType="vm:ShiftHandoverViewModel">

    <ScrollViewer>
        <StackPanel>
            
            <!-- Заголовок страницы -->
            <TextBlock Text="🔄 Передача смены" Classes="page-title"/>
            <TextBlock Text="Оформление передачи смены между бригадами" Classes="page-subtitle"/>

            <!-- Информация о сменах -->
            <Grid ColumnDefinitions="*,*" Margin="0,0,0,24">
                <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Текущая смена" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding CurrentShift}" 
                                   FontSize="14"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Classes="card" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Следующая смена" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding NextShift}" 
                                   FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Заметки для передачи -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="Заметки для передачи смены" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,16"/>
                    
                    <TextBox Text="{Binding HandoverNotes}" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             MinHeight="200" 
                             Watermark="Введите важную информацию для следующей смены..."/>
                    
                    <Button Content="💾 Создать передачу смены" 
                            Background="#2563EB" 
                            Foreground="White" 
                            Padding="16,12" 
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            CornerRadius="8"
                            Command="{Binding CreateHandoverCommand}"/>
                </StackPanel>
            </Border>

            <!-- История передач смен -->
            <Border Classes="card" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="История передач смен" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,16"/>
                    
                    <ItemsControl ItemsSource="{Binding ShiftHandovers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="0,16"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding ShiftType}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="14"/>
                                                <TextBlock Text=" смена" 
                                                           FontSize="14" 
                                                           Margin="4,0"/>
                                                <TextBlock Text="{Binding IsCompleted, Converter={x:Static converters:BoolToStringConverter.Instance}}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="12"
                                                           Foreground="{Binding IsCompleted, Converter={x:Static converters:BoolToColorConverter.Instance}}"
                                                           Margin="8,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding HandoverTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                                       FontSize="12" 
                                                       Foreground="#64748B"/>
                                        </Grid>
                                        
                                        <TextBlock Text="{Binding ImportantNotes}" 
                                                   FontSize="13" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,8,0,0"/>
                                        
                                        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding OutgoingOfficer, StringFormat='Передал: {0}'}" 
                                                       FontSize="11" 
                                                       Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding IncomingOfficer, StringFormat='Принял: {0}'}" 
                                                       FontSize="11" 
                                                       Foreground="#64748B"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>