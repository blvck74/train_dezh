<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDezhApp.ViewModels"
             xmlns:converters="using:TrainDezhApp.Converters"
             x:Class="TrainDezhApp.Views.MaterialsView"
             x:DataType="vm:MaterialsViewModel">

    <ScrollViewer>
        <StackPanel>
            
            <!-- Заголовок страницы -->
            <TextBlock Text="📦 МЗ (Материальные запасы)" Classes="page-title"/>
            <TextBlock Text="Учет и управление материальными запасами депо" Classes="page-subtitle"/>

            <!-- Панель действий -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="➕ Добавить материал" 
                        Background="#2563EB" 
                        Foreground="White" 
                        Padding="12,8" 
                        Margin="0,0,12,0"
                        CornerRadius="6"
                        Command="{Binding AddMaterialCommand}"/>
                <Button Content="📋 Инвентаризация" 
                        Background="#64748B" 
                        Foreground="White" 
                        Padding="12,8" 
                        Margin="0,0,12,0"
                        CornerRadius="6"/>
            </StackPanel>

            <!-- Список материалов -->
            <Border Classes="card">
                <StackPanel>
                    
                    <!-- Заголовок таблицы -->
                    <Border Background="#F8FAFC" 
                            Margin="-20,-20,-20,0" 
                            Padding="20,16">
                        <Grid ColumnDefinitions="*,150,120">
                        <TextBlock Grid.Column="0" 
                                   Text="Наименование" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Grid.Column="1" 
                                   Text="Количество" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Grid.Column="2" 
                                   Text="Статус" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Строки данных -->
                    <ItemsControl ItemsSource="{Binding Materials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" 
                                        BorderThickness="0,1,0,0" 
                                        Padding="0,16">
                                    <Grid ColumnDefinitions="*,150,120">
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Name}" 
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Quantity}" 
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text=" " 
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Unit}" 
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <Border Grid.Column="2" 
                                                Background="{Binding Status, Converter={x:Static converters:MaterialStatusToColorConverter.Instance}}"
                                                CornerRadius="12" 
                                                Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" 
                                                       FontSize="12" 
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>