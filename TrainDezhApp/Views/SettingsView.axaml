<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDezhApp.ViewModels"
             x:Class="TrainDezhApp.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel>
            
            <!-- Заголовок страницы -->
            <TextBlock Text="⚙️ Параметры" Classes="page-title"/>
            <TextBlock Text="Настройки приложения и системы" Classes="page-subtitle"/>

            <!-- Настройки базы данных -->
            <Border Classes="card" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="База данных" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Строка подключения:" 
                               FontSize="14" 
                               Margin="0,0,0,8"/>
                    <TextBox Text="{Binding DatabaseConnection}" 
                             Watermark="Server=localhost;Database=TrainDezh;User Id=postgres;Password=;"/>
                    
                    <Button Content="🔗 Проверить подключение" 
                            Background="#10B981" 
                            Foreground="White" 
                            Padding="12,8" 
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            CornerRadius="6"/>
                </StackPanel>
            </Border>

            <!-- Общие настройки -->
            <Border Classes="card" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Общие настройки" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,16"/>
                    
                    <CheckBox IsChecked="{Binding AutoSave}" 
                              Content="Автоматическое сохранение" 
                              Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Интервал обновления (сек):" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,12,0"/>
                        <NumericUpDown Value="{Binding RefreshInterval}" 
                                       Minimum="5" 
                                       Maximum="300" 
                                       Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal">
                <Button Content="💾 Сохранить настройки" 
                        Background="#2563EB" 
                        Foreground="White" 
                        Padding="16,12" 
                        Margin="0,0,12,0"
                        CornerRadius="8"/>
                <Button Content="🔄 Сбросить" 
                        Background="#64748B" 
                        Foreground="White" 
                        Padding="16,12" 
                        CornerRadius="8"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>