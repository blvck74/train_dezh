<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDezhApp.ViewModels"
             xmlns:models="using:TrainDezhApp.Models"
             xmlns:converters="using:TrainDezhApp.Converters"
             x:Class="TrainDezhApp.Views.UserManagementView"
             x:DataType="vm:UserManagementViewModel">

    <Design.DataContext>
        <vm:UserManagementViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- Основной контент -->
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">
                
                <!-- Заголовок -->
                <StackPanel Spacing="8">
                    <TextBlock Text="👥 Управление пользователями" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#1E293B"/>
                    <TextBlock Text="Добавление и управление пользователями системы" 
                               FontSize="14" 
                               Foreground="#64748B"/>
                </StackPanel>

                <!-- Панель действий -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{Binding AddUserCommand}"
                            Classes="primary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="➕" FontSize="14"/>
                            <TextBlock Text="Добавить пользователя"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding RefreshUsersCommand}"
                            Classes="secondary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔄" FontSize="14"/>
                            <TextBlock Text="Обновить"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Список пользователей -->
                <Border Classes="card">
                    <StackPanel Spacing="16">
                        
                        <TextBlock Text="Список пользователей" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"/>

                        <DataGrid ItemsSource="{Binding Users}"
                                  AutoGenerateColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True">
                            
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" 
                                                    Binding="{Binding FullName}" 
                                                    Width="*"/>
                                <DataGridTextColumn Header="Логин" 
                                                    Binding="{Binding Username}" 
                                                    Width="150"/>
                                <DataGridTemplateColumn Header="Роль" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:User">
                                            <Border Classes="role-badge"
                                                    Classes.admin="{Binding Role, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter={x:Static models:UserRole.Administrator}}">
                                                <TextBlock Text="{Binding Role, Converter={x:Static converters:UserRoleConverter.Instance}}"
                                                           FontSize="12"
                                                           FontWeight="Medium"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Дата создания" 
                                                    Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                                    Width="150"/>
                            </DataGrid.Columns>
                            
                        </DataGrid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Диалог добавления пользователя -->
        <Border IsVisible="{Binding IsAddUserDialogOpen}"
                Background="#80000000"
                ZIndex="100">
            
            <Border Background="White"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #00000040"
                    MaxWidth="500"
                    Margin="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                
                <StackPanel Margin="32" Spacing="24">
                    
                    <!-- Заголовок диалога -->
                    <TextBlock Text="Добавить нового пользователя" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <!-- Форма, если пароль не сгенерирован -->
                    <StackPanel Spacing="16" IsVisible="{Binding !IsPasswordGenerated}">
                        
                        <!-- ФИО -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="ФИО *" FontWeight="Medium"/>
                            <TextBox Text="{Binding NewUserFullName}"
                                     Watermark="Введите полное имя пользователя"/>
                        </StackPanel>

                        <!-- Логин -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Логин *" FontWeight="Medium"/>
                            <TextBox Text="{Binding NewUserUsername}"
                                     Watermark="Введите логин пользователя"/>
                        </StackPanel>

                        <!-- Роль -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Роль *" FontWeight="Medium"/>
                            <ComboBox SelectedItem="{Binding NewUserRole}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Пользователь" Tag="{x:Static models:UserRole.User}"/>
                                <ComboBoxItem Content="Администратор" Tag="{x:Static models:UserRole.Administrator}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Сообщение об ошибке -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"/>

                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    Spacing="12">
                            <Button Content="Отмена" 
                                    Command="{Binding CancelAddUserCommand}"
                                    Classes="secondary"/>
                            <Button Content="Создать" 
                                    Command="{Binding CreateUserCommand}"
                                    Classes="primary"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Результат создания пользователя -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsPasswordGenerated}">
                        
                        <Border Background="#F0FDF4" 
                                BorderBrush="#22C55E" 
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="✅ Пользователь успешно создан!" 
                                           FontWeight="Medium" 
                                           Foreground="#15803D"/>
                                
                                <TextBlock Text="Скопируйте данные для входа:" 
                                           FontSize="12" 
                                           Foreground="#166534"/>
                            </StackPanel>
                        </Border>

                        <!-- Данные пользователя -->
                        <StackPanel Spacing="12">
                            
                            <!-- ФИО -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="ФИО:" FontSize="12" Foreground="#64748B"/>
                                <Border Background="#F8FAFC" 
                                        BorderBrush="#E2E8F0" 
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding NewUserFullName}" 
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="📋" 
                                                Command="{Binding CopyToClipboardCommand}"
                                                CommandParameter="{Binding NewUserFullName}"
                                                Classes="icon-button"
                                                ToolTip.Tip="Копировать"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Логин -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Логин:" FontSize="12" Foreground="#64748B"/>
                                <Border Background="#F8FAFC" 
                                        BorderBrush="#E2E8F0" 
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding NewUserUsername}" 
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="📋" 
                                                Command="{Binding CopyToClipboardCommand}"
                                                CommandParameter="{Binding NewUserUsername}"
                                                Classes="icon-button"
                                                ToolTip.Tip="Копировать"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Пароль -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Пароль:" FontSize="12" Foreground="#64748B"/>
                                <Border Background="#FEF3C7" 
                                        BorderBrush="#F59E0B" 
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding GeneratedPassword}" 
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="📋" 
                                                Command="{Binding CopyToClipboardCommand}"
                                                CommandParameter="{Binding GeneratedPassword}"
                                                Classes="icon-button"
                                                ToolTip.Tip="Копировать"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                        <!-- Кнопка закрытия -->
                        <Button Content="Закрыть" 
                                Command="{Binding CancelAddUserCommand}"
                                Classes="primary"
                                HorizontalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>